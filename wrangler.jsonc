{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cost",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "DICTIONARY",
      "id": "a177c931713740eba16c33ff4401706d"
    }
  ],
  "observability": {
    "enabled": true
  }
}
